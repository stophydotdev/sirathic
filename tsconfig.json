{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "bun"]
  },
  "include": ["apps", "packages", "scripts", "test"],
  "exclude": ["apps/web", "apps/mobile", "test/web.test.ts"]
}
