{
  "name": "sirathic",
  "description": "Answer engine for Islamic knowledge multi-school, citation-first",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "check-types": "turbo check-types",
    "dev:server": "turbo -F @sirathic/server dev",
    "dev:web": "turbo -F @sirathic/web dev",
    "build": "turbo build",
    "start:web": "turbo -F @sirathic/web start",
    "query": "bun --env-file=apps/server/.env scripts/query.ts",
    "search": "bun --env-file=apps/server/.env scripts/search.ts",
    "lint": "oxlint",
    "test": "bun test test"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "oxlint": "1.60.0",
    "turbo": "2.10.2",
    "typescript": "5.8.2"
  }
}
