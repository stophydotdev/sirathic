{
  "name": "sirathic",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter @sirathic/server --filter web dev",
    "test": "bun test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check": "oxlint && oxfmt --write && ! git grep -nIP --untracked '\\x{2014}' -- ':!apps/web/AGENTS.md' ':!apps/server/src/chat/prompt.ts'",
    "check-slop": "oxlint --deny-warnings",
    "check-types": "tsc-rs --noEmit && tsc-rs --noEmit -p apps/mobile && bun run --filter web check-types",
    "check-dead": "bun run env ./node_modules/.bin/knip --no-progress",
    "env": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local",
    "db:crawl": "bun run env scripts/fatwas.ts && bun run env scripts/dedupeFatwas.ts --apply && bun run env scripts/embed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@sirathic/core": "workspace:*",
    "@sirathic/db": "workspace:*",
    "@sirathic/env": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hyparquet": "^1.31.4",
    "hyparquet-compressors": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
    "knip": "6.41.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.88.0",
    "tsc-rs": "0.7.0",
    "typescript": "7"
  }
}
