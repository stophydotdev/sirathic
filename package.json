{
  "name": "sirathic",
  "description": "Answer engine for Islamic knowledge multi-school, citation-first",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./dev.sh",
    "check-types": "turbo check-types",
    "typecheck": "bun run check-types",
    "dev:server": "turbo -F @sirathic/server dev",
    "dev:web": "turbo -F @sirathic/web dev",
    "build": "turbo build",
    "start:web": "turbo -F @sirathic/web start",
    "db:push": "turbo -F @sirathic/db db:push",
    "db:generate": "turbo -F @sirathic/db db:generate",
    "db:migrate": "turbo -F @sirathic/db db:migrate",
    "db:studio": "turbo -F @sirathic/db db:studio",
    "ask": "bun --env-file=apps/server/.env scripts/query.ts",
    "query": "bun --env-file=apps/server/.env scripts/query.ts",
    "search": "bun --env-file=apps/server/.env scripts/search.ts",
    "lint": "oxlint",
    "test": "turbo test",
    "infra:build": "docker compose -f infra/compose.yml build",
    "infra:up": "docker compose --env-file infra/.env -f infra/compose.yml up --build -d",
    "infra:down": "docker compose --env-file infra/.env -f infra/compose.yml down",
    "smoke:fetch": "bun run scripts/smoke-fetch.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "oxlint": "1.60.0",
    "turbo": "2.10.2",
    "typescript": "5.8.2"
  }
}
