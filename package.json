{
  "name": "sirathic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @sirathic/server --filter web dev",
    "start": "bun run --filter @sirathic/server start",
    "typecheck": "tsc-rs --noEmit",
    "test": "bun test",
    "lint": "oxlint && biome check",
    "lint:fix": "oxlint --fix && biome check --write",
    "format": "biome format --write",
    "knip": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local ./node_modules/.bin/knip",
    "search": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/search.ts",
    "fetch": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/fetch.ts",
    "datasets": "bun scripts/datasets.ts",
    "db:push": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/extensions.ts && bun --env-file=apps/server/.env --env-file=apps/server/.env.local drizzle-kit push",
    "db:load": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/load.ts && bun run db:enrich",
    "db:enrich": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/enrich.ts",
    "db:fiqh": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/fiqh.ts",
    "db:qul": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/qul.ts",
    "db:embed": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/embed.ts",
    "db:fatwas": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/fatwas.ts",
    "db:dedupe-fatwas": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/dedupe-fatwas.ts",
    "db:crawl": "bun run db:fatwas && bun run db:dedupe-fatwas --apply && bun run db:embed",
    "db:reddit": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/reddit.ts",
    "db:hadith-english": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/hadith-english.ts",
    "translate": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/translate-hadiths.ts",
    "i18n:keys": "bun scripts/i18n-keys.ts",
    "i18n:check": "bun scripts/i18n-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@sirathic/core": "workspace:*",
    "@sirathic/db": "workspace:*",
    "@sirathic/env": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hyparquet": "^1.31.4",
    "hyparquet-compressors": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
    "knip": "6.41.0",
    "oxlint": "1.88.0",
    "tsc-rs": "0.7.0",
    "typescript": "7"
  }
}
