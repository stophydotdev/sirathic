{
  "name": "sirathic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter server dev",
    "start": "bun run --filter server start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "search": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/search.ts",
    "fetch": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/fetch.ts",
    "ask": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/ask.ts",
    "answer": "bun --env-file=apps/server/.env --env-file=apps/server/.env.local scripts/answer.ts"
  },
  "dependencies": {
    "@sirathic/api": "workspace:*",
    "@sirathic/core": "workspace:*",
    "@sirathic/env": "workspace:*",
    "ai": "^7.0.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^20",
    "typescript": "7"
  }
}
