{
  "name": "sirathic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --hot apps/server/src/index.ts",
    "start": "bun apps/server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "search": "bun scripts/search.ts",
    "fetch": "bun scripts/fetch.ts",
    "ask": "bun scripts/ask.ts",
    "answer": "bun scripts/answer.ts"
  },
  "dependencies": {
    "@sirathic/api": "workspace:*",
    "@sirathic/core": "workspace:*",
    "@sirathic/env": "workspace:*",
    "ai": "^7.0.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "7"
  }
}
