{
  "expo": {
    "name": "Sirathic",
    "slug": "sirathic",
    "scheme": "sirathic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.sirathic.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sirathic.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161616",
          "image": "./assets/splash-icon.png",
          "imageWidth": 64
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Sirathic to use your microphone for voice input.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false
    }
  }
}
