{
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.refresh_interval": "1s",
      "index.codec": "best_compression"
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "id": { "type": "keyword" },
        "document_id": { "type": "keyword" },
        "chunk_number": { "type": "integer" },
        "content_hash": { "type": "keyword" },
        "language": { "type": "keyword" },
        "url": { "type": "keyword", "ignore_above": 2048 },
        "canonical_url": { "type": "keyword", "ignore_above": 2048 },
        "domain": { "type": "keyword" },
        "source_id": { "type": "keyword" },
        "source_name": {
          "type": "text",
          "fields": { "exact": { "type": "keyword", "ignore_above": 512 } }
        },
        "source_role": { "type": "keyword" },
        "authority_tier": { "type": "byte" },
        "is_primary_source": { "type": "boolean" },
        "topics": { "type": "keyword" },
        "madhhabs": { "type": "keyword" },
        "regions": { "type": "keyword" },
        "scholars": { "type": "keyword" },
        "book": {
          "type": "text",
          "fields": { "exact": { "type": "keyword", "ignore_above": 512 } }
        },
        "reference": { "type": "keyword", "ignore_above": 512 },
        "published_at": { "type": "date", "ignore_malformed": true },
        "crawled_at": { "type": "date" },
        "updated_at": { "type": "date" },
        "metadata": { "type": "flattened" }
      }
    }
  },
  "_meta": {
    "description": "Shared metadata for Sirathic source passages",
    "schema_version": 1
  }
}
