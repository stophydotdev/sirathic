{
  "index_patterns": ["sirathic-passages-__LANGUAGE__-*"],
  "priority": 200,
  "composed_of": ["sirathic-passages-common"],
  "template": {
    "mappings": {
      "properties": {
        "title": {
          "type": "text",
          "analyzer": "__ANALYZER__",
          "fields": { "exact": { "type": "keyword", "ignore_above": 1024 } }
        },
        "body": { "type": "text", "analyzer": "__ANALYZER__" },
        "excerpt": { "type": "text", "analyzer": "__ANALYZER__" }
      }
    }
  },
  "_meta": {
    "description": "Sirathic __LANGUAGE__ passages using the __ANALYZER__ analyzer",
    "schema_version": 1
  }
}
